#!/bin/sh

set -e

KEYRING_PATH="/usr/share/keyrings/prefork-packages.asc"
LIST_PATH="/etc/apt/sources.list.d/prefork-packages.list"
SOURCES_PATH="/etc/apt/sources.list.d/prefork-packages.sources"

case "$1" in
  remove)
    rm -f "${LIST_PATH}" "${SOURCES_PATH}"
    ;;
  purge)
    rm -f "${LIST_PATH}" "${SOURCES_PATH}" "${KEYRING_PATH}"
    ;;
esac

#DEBHELPER#

exit 0
